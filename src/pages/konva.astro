---
import Layout from '@/layouts/Layout.astro'
import Footer from '@/components/Footer.astro'
import DarkModeButton from '@/components/DarkModeButton.astro'
---

<Layout>
  <div class="@container relative flex min-h-dvh min-w-sm flex-col items-center">
    <div class="bg-dots fade-b absolute inset-x-0 top-0 h-48"></div>
    <DarkModeButton class="fixed top-8 right-8" />
    <div id="container"></div>
    <Footer />
  </div>
</Layout>

<script>
  import Konva from 'konva'

  const STORKE_WIDTH = 4

  function addRingAoe(x: number, y: number, innerRadius: number, outerRadius: number) {
    const aoe = new Konva.Group({ draggable: true })
    // 原始形状保持在同一层但不进入发光组，避免被组内destination-out影响
    const ring = new Konva.Ring({
      x,
      y,
      innerRadius: innerRadius + STORKE_WIDTH / 2,
      outerRadius: outerRadius - STORKE_WIDTH / 2,
      fill: '#fb923c',
      opacity: 0.2,
    })
    aoe.add(ring)

    // 内发光：单层内的独立组，组内缓存隔离混合与滤镜
    const innerGlowGroup = new Konva.Group()
    aoe.add(innerGlowGroup)

    const innerGlowBase = ring.clone({
      fill: '#ff751f',
      stroke: '#ff751f',
      strokeWidth: STORKE_WIDTH,
      opacity: 1,
    })

    const innerGlowShadow = ring.clone({
      fill: '#ff751f',
      shadowColor: '#ff751f',
      shadowBlur: 32,
      shadowOpacity: 0.1,
      shadowOffset: { x: 0, y: 0 },
      opacity: 1,
      globalCompositeOperation: 'destination-out',
    })

    innerGlowShadow.cache()
    innerGlowShadow.filters([Konva.Filters.Blur])
    innerGlowShadow.blurRadius(48)

    innerGlowGroup.add(innerGlowBase)
    innerGlowGroup.add(innerGlowShadow)

    // 关键：缓存整个组，确保destination-out和滤镜只在组内发生
    const pad = 64
    const innerGlowRect = innerGlowGroup.getClientRect({ skipShadow: false, skipStroke: false })
    innerGlowGroup.cache({
      x: innerGlowRect.x - pad,
      y: innerGlowRect.y - pad,
      width: innerGlowRect.width + pad * 2,
      height: innerGlowRect.height + pad * 2,
    })

    // 外发光：同样使用单层内的独立组
    const outerGlowGroup = new Konva.Group()
    aoe.add(outerGlowGroup)

    const outerGlowBase = ring.clone({
      fill: '#fffc79',
      stroke: '#fffc79',
      strokeWidth: STORKE_WIDTH,
      opacity: 1,
    })

    const outerGlowShadow = ring.clone({
      fill: '#fffc79',
      shadowColor: '#fffc79',
      shadowBlur: 32,
      shadowOpacity: 1,
      shadowOffset: { x: 0, y: 0 },
      opacity: 1,
      globalCompositeOperation: 'destination-out',
    })

    outerGlowShadow.cache()
    outerGlowShadow.filters([Konva.Filters.Blur])
    outerGlowShadow.blurRadius(16)

    outerGlowGroup.add(outerGlowBase)
    outerGlowGroup.add(outerGlowShadow)

    const outerGlowRect = outerGlowGroup.getClientRect({ skipShadow: false, skipStroke: false })
    outerGlowGroup.cache({
      x: outerGlowRect.x - pad,
      y: outerGlowRect.y - pad,
      width: outerGlowRect.width + pad * 2,
      height: outerGlowRect.height + pad * 2,
    })

    // 可选：加深外发光强度，克隆一份外发光组
    const outerGlowGroup1 = outerGlowGroup.clone()
    outerGlowGroup1.clearCache()
    outerGlowGroup1.cache({
      x: outerGlowRect.x - pad,
      y: outerGlowRect.y - pad,
      width: outerGlowRect.width + pad * 2,
      height: outerGlowRect.height + pad * 2,
    })
    aoe.add(outerGlowGroup1)

    return aoe
  }

  const stage = new Konva.Stage({
    container: 'container',
    width: window.innerWidth,
    height: window.innerHeight,
  })

  const layer = new Konva.Layer()
  stage.add(layer)

  const aoe = addRingAoe(stage.width() / 2, stage.height() / 2, 120, 200)
  const aoe1 = addRingAoe(stage.width() / 2 + 110, stage.height() / 2 + 70, 80, 160)
  layer.add(aoe)
  layer.add(aoe1)
</script>
