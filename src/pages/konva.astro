---
import Layout from '@/layouts/Layout.astro'
import Footer from '@/components/Footer.astro'
import DarkModeButton from '@/components/DarkModeButton.astro'
---

<Layout>
  <div class="@container relative flex min-h-dvh min-w-sm flex-col items-center">
    <div class="bg-dots fade-b absolute inset-x-0 top-0 h-48"></div>
    <DarkModeButton class="fixed top-8 right-8" />
    <div id="container"></div>
    <Footer />
  </div>
</Layout>

<script>
  import Konva from 'konva'

  const STORKE_WIDTH = 4
  const PADDING = 64

  function createGlow(
    shape: Konva.Shape,
    baseConfig: Konva.ShapeConfig,
    shadowConfig: Konva.ShapeConfig,
    blurRadius: number,
  ) {
    const group = new Konva.Group()

    const base = shape.clone(baseConfig)

    const shadow = shape.clone(shadowConfig)
    shadow.cache()
    shadow.filters([Konva.Filters.Blur])
    shadow.blurRadius(blurRadius)

    group.add(base)
    group.add(shadow)

    const rect = group.getClientRect({ skipShadow: false, skipStroke: false })
    group.cache({
      x: rect.x - PADDING,
      y: rect.y - PADDING,
      width: rect.width + PADDING * 2,
      height: rect.height + PADDING * 2,
    })

    return group
  }

  function createInnerGlow(shape: Konva.Shape, color: string = '#ff751f') {
    const group = new Konva.Group()
    group.add(
      createGlow(
        shape,
        {
          fill: color,
          stroke: color,
          strokeWidth: STORKE_WIDTH,
          opacity: 1,
        },
        {
          fill: color,
          shadowColor: color,
          shadowBlur: 32,
          shadowOpacity: 0.1,
          shadowOffset: { x: 0, y: 0 },
          opacity: 1,
          globalCompositeOperation: 'destination-out',
        },
        32,
      ),
    )
    group.add(
      createGlow(
        shape,
        {
          fill: color,
          stroke: color,
          strokeWidth: STORKE_WIDTH,
          opacity: 1,
        },
        {
          fill: color,
          shadowColor: color,
          shadowBlur: 32,
          shadowOpacity: 0.1,
          shadowOffset: { x: 0, y: 0 },
          opacity: 1,
          globalCompositeOperation: 'destination-out',
        },
        48,
      ),
    )
    return group
  }

  function createOuterGlow(shape: Konva.Shape, color: string = '#fffc79') {
    const group = new Konva.Group()
    group.add(
      createGlow(
        shape,
        {
          fill: color,
          stroke: color,
          strokeWidth: STORKE_WIDTH,
          opacity: 1,
        },
        {
          fill: color,
          shadowColor: color,
          shadowBlur: 32,
          shadowOpacity: 1,
          shadowOffset: { x: 0, y: 0 },
          opacity: 1,
          globalCompositeOperation: 'destination-out',
        },
        8,
      ),
    )
    group.add(
      createGlow(
        shape,
        {
          fill: color,
          stroke: color,
          strokeWidth: STORKE_WIDTH,
          opacity: 1,
        },
        {
          fill: color,
          shadowColor: color,
          shadowBlur: 32,
          shadowOpacity: 1,
          shadowOffset: { x: 0, y: 0 },
          opacity: 1,
          globalCompositeOperation: 'destination-out',
        },
        16,
      ),
    )
    return group
  }

  function addRingAoe(x: number, y: number, innerRadius: number, outerRadius: number) {
    const aoe = new Konva.Group({ draggable: true })
    // 原始形状保持在同一层但不进入发光组，避免被组内destination-out影响
    const ring = new Konva.Ring({
      x,
      y,
      innerRadius: innerRadius + STORKE_WIDTH / 2,
      outerRadius: outerRadius - STORKE_WIDTH / 2,
      fill: '#fb923c',
      opacity: 0.25,
    })
    aoe.add(ring)

    // 内发光：单层内的独立组，组内缓存隔离混合与滤镜
    aoe.add(createInnerGlow(ring))

    // 外发光：同样使用单层内的独立组
    aoe.add(createOuterGlow(ring))

    return aoe
  }

  const stage = new Konva.Stage({
    container: 'container',
    width: window.innerWidth,
    height: window.innerHeight,
  })

  const layer = new Konva.Layer()
  stage.add(layer)

  const aoe = addRingAoe(stage.width() / 2, stage.height() / 2, 120, 200)
  const aoe1 = addRingAoe(stage.width() / 2 + 110, stage.height() / 2 + 70, 80, 160)
  layer.add(aoe)
  layer.add(aoe1)
</script>
