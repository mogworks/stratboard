---
import Layout from '@/layouts/Layout.astro'
import StratBoard from '@/components/StratBoard.astro'
---

<Layout title="M8S2">
  <div class="flex h-screen w-screen items-center justify-center">
    <StratBoard key="stratboard" />
  </div>
</Layout>

<script>
  import { listenKeys } from 'nanostores'
  import { Assets, Container, Graphics, Sprite } from 'pixi.js'

  import type { RoleType } from '@/lib/role'

  import { create_chn_closer_0v } from '@/pixi/channeling/chn_closer_0v'
  import { create_chn_leave_0v } from '@/pixi/channeling/chn_leave_0v'
  import { distance, getMidpoint, scaleCoordinates } from '@/pixi/coordinates'
  import { Role } from '@/pixi/role'
  import { getScale, YmToPx } from '@/pixi/scale'
  import { createTower } from '@/pixi/tower'
  import { $stratBoards } from '@/stores/stratBoards'

  import { platform_to_coord } from '../_utils.ts'

  import floor_img from '/assets/07/m8s2/floor_14@3x.png?url'

  const name = 'lone_wolfs_lament_solution2'

  listenKeys($stratBoards, ['stratboard'], async (stratBoards) => {
    const app = stratBoards.stratboard

    const c = new Container()
    c.position.set(app.screen.width / 2, app.screen.height / 2)
    app.stage.addChild(c)

    const container = new Container()

    const floorTexture = await Assets.load(floor_img)
    const floor = Sprite.from(floorTexture)
    const YmToPxLarge = YmToPx * 1.25
    floor.anchor.set(0.5, 0.5)
    floor.scale.set(getScale() * 1.25)
    container.addChild(floor)

    const types = [3, 1, 2, 1, 1] as const

    for (let i = 0; i < 5; i++) {
      const { tower, pillars } = await createTower(types[i], { r: 17.54, deg: 90 + i * 72 }, 1.25)
      tower.scale.set(tower.scale.x * 1.25, tower.scale.y * 1.25)
      container.addChild(tower)
      pillars.forEach((pillar) => {
        pillar.scale.set(pillar.scale.x * 1.25, pillar.scale.y * 1.25)
        container.addChild(pillar)
      })
    }

    const roleParams: {
      type: RoleType
      tag: string
      platform: number
      offset: { vertical: number; horizontal: number }
    }[] = [
      { type: 'tank', tag: 'MT', platform: 2, offset: { vertical: 0, horizontal: -1.2 } },
      { type: 'healer', tag: 'H1', platform: 0, offset: { vertical: -1, horizontal: -1.2 } },
      { type: 'melee', tag: 'D1', platform: 2, offset: { vertical: 0, horizontal: 1.2 } },
      { type: 'ranged', tag: 'D3', platform: 0, offset: { vertical: 1.4, horizontal: 0 } },
      { type: 'dps', tag: 'D2', platform: 4, offset: { vertical: 0, horizontal: 1 } },
      { type: 'magic', tag: 'D4', platform: 3, offset: { vertical: -1, horizontal: 0.5 } },
      { type: 'tank', tag: 'ST', platform: 1, offset: { vertical: 0, horizontal: -1 } },
      { type: 'healer', tag: 'H2', platform: 0, offset: { vertical: -1, horizontal: 1.2 } },
    ]

    roleParams.forEach((r) => {
      const role = new Role(r.type, r.tag)
      role.scale.set(0.4)

      const pos = platform_to_coord(r.platform, r.offset, YmToPxLarge)

      role.position.set(pos.x, pos.y)
      container.addChild(role)
    })

    // 0 == close, 1 == far
    const tetherParam = [
      { start: roleParams[6], end: roleParams[4], type: 1 },
      { start: roleParams[0], end: roleParams[2], type: 0 },
      { start: roleParams[7], end: roleParams[3], type: 0 },
      { start: roleParams[5], end: roleParams[1], type: 1 },
    ]

    for (const r of tetherParam) {
      const startPos = platform_to_coord(r.start.platform, r.start.offset)

      const endPos = platform_to_coord(r.end.platform, r.end.offset)

      const d = distance(startPos, endPos)

      const chn = r.type === 0 ? await create_chn_closer_0v(d, 1.25) : await create_chn_leave_0v(d, 1.25)
      chn.position = scaleCoordinates(getMidpoint(startPos, endPos), YmToPxLarge)
      chn.rotation = Math.atan2(endPos.y - startPos.y, endPos.x - startPos.x)
      container.addChild(chn)
    }

    roleParams.forEach((r) => {
      const role = new Role(r.type, r.tag)
      role.scale.set(0.4)

      const pos = platform_to_coord(r.platform, r.offset, YmToPxLarge)

      role.position.set(pos.x, pos.y)
      container.addChild(role)
    })

    c.addChild(container)

    const circle = new Graphics()
    circle.rect(-314, -280, 628, 602)
    circle.fill({ color: 'white', alpha: 0 })
    c.addChild(circle)

    const mask = new Graphics()
    mask.rect(-314, -280, 628, 602)
    mask.fill({ color: 'white', alpha: 0 })
    c.addChild(mask)
    c.mask = mask
    c.addChild(mask)

    // take screenshot
    await new Promise((resolve) => setTimeout(resolve, 1000))
    const url = await app.renderer.extract.base64(app.stage)
    const screenshot = document.createElement('a')
    document.body.append(screenshot)
    screenshot.style.position = 'fixed'
    screenshot.style.top = '20px'
    screenshot.style.right = '20px'
    screenshot.download = name
    screenshot.href = url
    const image = new Image()
    image.width = app.screen.width / 4
    image.src = url
    screenshot.innerHTML = image.outerHTML
  })
</script>
