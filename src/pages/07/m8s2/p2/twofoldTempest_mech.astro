---
import Layout from '@/layouts/Layout.astro'
import StratBoard from '@/components/StratBoard.astro'
---

<Layout title="M8S2">
  <div class="flex h-screen w-screen items-center justify-center">
    <StratBoard key="stratboard" />
  </div>
</Layout>

<script>
  import { listenKeys } from 'nanostores'
  import { Assets, Container, Graphics, Sprite } from 'pixi.js'

  import type { RoleType } from '@/lib/role'
  import type { PolarAngleCoordinates } from '@/pixi/coordinates'

  import { AoE, AOE_COLORS } from '@/pixi/aoe'
  import { create_chn_teke01h } from '@/pixi/channeling/chn_teke01h'
  import { convertCoordinates, degToRad, distance, getMidpoint, scaleCoordinates } from '@/pixi/coordinates'
  import { Role } from '@/pixi/role'
  import { getScale, YmToPx } from '@/pixi/scale'
  import { $stratBoards } from '@/stores/stratBoards'

  import floor_img from '/assets/07/m8s2/floor_9@3x.png?url'

  const name = 'twofoldTempest_mech'

  listenKeys($stratBoards, ['stratboard'], async (stratBoards) => {
    const app = stratBoards.stratboard

    const c = new Container()
    c.position.set(app.screen.width / 2, app.screen.height / 2)
    app.stage.addChild(c)

    const container = new Container()

    const floorTexture = await Assets.load(floor_img)
    const floor = Sprite.from(floorTexture)
    floor.anchor.set(0.5, 0.5)
    floor.scale.set(getScale() * 1.25)
    container.addChild(floor)

    const ray = AoE.createRay(16 * 1.25, 40, {
      colors: AOE_COLORS.tailwind.lime,
    }).toSprite(app)
    ray.rotation = degToRad(-126)
    container.addChild(ray)

    const roleParams: {
      type: RoleType
      p: PolarAngleCoordinates
    }[] = [
      { type: 'any', p: { r: 17.54 + 7, deg: 90 - 72 } },
      { type: 'any', p: { r: 17.54 - 7, deg: 90 - 72 * 3 } },
    ]

    const aoeCircles = AoE.createCircles(app, [
      {
        position: { r: roleParams[0].p.r * 1.25, deg: roleParams[0].p.deg },
        radius: 6 * 1.25,
        options: {
          colors: AOE_COLORS.tailwind.teal,
        },
      },
      {
        position: { r: roleParams[0].p.r * 1.25, deg: 90 - 72 * 2 },
        radius: 10 * 1.25,
        options: {
          colors: AOE_COLORS.tailwind.green,
        },
      },
    ])
    container.addChild(aoeCircles)

    const pos1 = { x: 0, y: 0 }
    const pos2 = convertCoordinates(roleParams[0].p, 'cartesian')
    const chn = await create_chn_teke01h(distance(pos1, pos2) * 1.25, 1.25)
    chn.position = scaleCoordinates(getMidpoint(pos1, pos2), 1.25 * YmToPx)
    chn.rotation = Math.atan2(pos2.y - pos1.y, pos2.x - pos1.x)
    container.addChild(chn)

    roleParams.forEach((r) => {
      const role = new Role(r.type)
      role.scale.set(0.5)

      const pos = scaleCoordinates(convertCoordinates(r.p, 'cartesian'), 1.25 * YmToPx)

      role.position.set(pos.x, pos.y)
      container.addChild(role)
    })

    c.addChild(container)

    const circle = new Graphics()
    circle.circle(0, 0, 440)
    circle.fill({ color: 'white', alpha: 0 })
    c.addChild(circle)

    const mask = new Graphics()
    mask.circle(0, 0, 440)
    mask.fill({ color: 'white', alpha: 0 })
    c.addChild(mask)
    c.mask = mask
    c.addChild(mask)

    // take screenshot
    await new Promise((resolve) => setTimeout(resolve, 1000))
    const url = await app.renderer.extract.base64(app.stage)
    const screenshot = document.createElement('a')
    document.body.append(screenshot)
    screenshot.style.position = 'fixed'
    screenshot.style.top = '20px'
    screenshot.style.right = '20px'
    screenshot.download = name
    screenshot.href = url
    const image = new Image()
    image.width = app.screen.width / 4
    image.src = url
    screenshot.innerHTML = image.outerHTML
  })
</script>
