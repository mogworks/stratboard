---
import Layout from '@/layouts/Layout.astro'
import StratBoard from '@/components/StratBoard.astro'
---

<Layout title="Necron">
  <div class="flex h-screen w-screen items-center justify-center">
    <StratBoard key="stratboard" class="scale-200" />
  </div>
</Layout>

<script>
  import { listenKeys } from 'nanostores'
  import { Assets, Container, Graphics, Sprite } from 'pixi.js'

  import type { RoleType } from '@/lib/role'

  import { AoE, AOE_PRESET } from '@/pixi/aoe'
  import { Role } from '@/pixi/role'
  import { getScale, YmToPx } from '@/pixi/scale'
  import { setWaymark } from '@/pixi/waymark'
  import { $stratBoards } from '@/stores/stratBoards'

  import { waymarkData } from './_waymark'

  import floor_img from '/assets/07/necron/floor@3x.png?url'
  import target_circle_img from '/assets/target_circle/r16@3x.png?url'

  const name = 'MementoMori_solution_2'

  listenKeys($stratBoards, ['stratboard'], async (stratBoards) => {
    const app = stratBoards.stratboard

    const container = new Container()
    container.position.set(app.screen.width / 2, app.screen.height / 2)
    app.stage.addChild(container)

    const floorTexture = await Assets.load(floor_img)
    const floor = Sprite.from(floorTexture)
    floor.anchor.set(0.5, 0.5)
    floor.scale.set(getScale())
    container.addChild(floor)

    const target_circle_texture = await Assets.load(target_circle_img)
    const target_circle = Sprite.from(target_circle_texture)
    target_circle.position.set(0, -17 * YmToPx)
    target_circle.anchor.set(0.5, 0.5)
    target_circle.rotation = Math.PI
    container.addChild(target_circle)

    const chokingGrasp = AoE.createRays(app, [
      { width: 5, length: 20, position: { x: 5, y: -10 }, alpha: 0.75 },
      { width: 5, length: 20, position: { x: 5, y: -5 }, alpha: 0.75 },
      { width: 5, length: 20, position: { x: -5, y: 0 }, rotation: 180, alpha: 0.75 },
      { width: 5, length: 20, position: { x: 5, y: 5 }, alpha: 0.75 },
      { width: 5, length: 20, position: { x: 5, y: 10 }, alpha: 0.75 },
    ])
    container.addChild(chokingGrasp)

    const dangerArea = AoE.createRects(app, [{ width: 10, height: 25, options: AOE_PRESET.style_5 }])
    container.addChild(dangerArea)

    await setWaymark(container, waymarkData, 0.75)

    const roleParams: { type: RoleType; tag: string; x: number; y: number }[] = [
      { type: 'tank', tag: 'MT', x: -14.25, y: -11.75 },
      { type: 'melee', tag: 'D1', x: -5.75, y: -11.75 },
      { type: 'healer', tag: 'H1', x: -5.75, y: 11.25 },
      { type: 'ranged', tag: 'D3', x: -14.25, y: 11.25 },
      { type: 'tank', tag: 'ST', x: -14.25, y: -3.25 },
      { type: 'dps', tag: 'D2', x: -5.75, y: -3.25 },
      { type: 'healer', tag: 'H2', x: 5.75, y: 0 },
      { type: 'magic', tag: 'D4', x: 14.25, y: 0 },
    ]
    const circleAoe = AoE.createCircles(
      app,
      [
        { position: { x: roleParams[0].x, y: roleParams[0].y } },
        { position: { x: roleParams[1].x, y: roleParams[1].y } },
        { position: { x: roleParams[2].x, y: roleParams[2].y } },
        { position: { x: roleParams[3].x, y: roleParams[3].y } },
        { position: { x: roleParams[4].x, y: roleParams[4].y } },
        { position: { x: roleParams[5].x, y: roleParams[5].y } },
        { position: { x: roleParams[6].x, y: roleParams[6].y } },
        { position: { x: roleParams[7].x, y: roleParams[7].y } },
      ],
      8,
      AOE_PRESET.style_3,
    )
    container.addChild(circleAoe)

    const roles: Role[] = []
    roleParams.forEach((r) => {
      const role = new Role(r.type, r.tag)
      role.scale.set(0.25)
      role.position.set(r.x * YmToPx, r.y * YmToPx)
      container.addChild(role)
      roles.push(role)
    })

    const squareMask = new Graphics()
    const width = 30 * YmToPx // 46.4
    const height = 25 * YmToPx
    squareMask.rect(-width / 2, -height / 2, width, height)
    squareMask.fill({ color: 'white' })
    container.mask = squareMask
    container.addChild(squareMask)

    // take screenshot
    await new Promise((resolve) => setTimeout(resolve, 1000))
    const url = await app.renderer.extract.base64(app.stage)
    const screenshot = document.createElement('a')
    document.body.append(screenshot)
    screenshot.style.position = 'fixed'
    screenshot.style.top = '20px'
    screenshot.style.right = '20px'
    screenshot.download = name
    screenshot.href = url
    const image = new Image()
    image.width = app.screen.width / 8
    image.src = url
    screenshot.innerHTML = image.outerHTML
  })
</script>
